---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Preloader from "../components/Preloader.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Divine Obeten - Frontend Engineer",
  description = "Divine Obeten's portfolio built with Astro, Tailwind, and GSAP.",
  image = "/og-image.svg",
} = Astro.props;

const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImage = new URL(image, siteUrl).toString();
---

<!doctype html>
<html lang="en" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script is:inline>
      if (!window.__booted) {
        window.__booted = true;
        const root = document.documentElement;
        root.classList.add("is-loading");
        if (location.pathname === "/") root.classList.add("hero-pending");
      }
    </script>
    <style is:inline>
      .preloader {
        display: none;
      }
      html.is-loading .preloader {
        display: grid;
      }
      html.is-loading,
      html.is-loading body {
        overflow: hidden;
      }

      html.hero-pending [data-hero] {
        opacity: 0;
        transform: translateY(32px);
      }
      html.hero-pending [data-hero-nav] {
        opacity: 0;
        transform: translateY(-16px);
      }

      @media (prefers-reduced-motion: reduce) {
        html.hero-pending [data-hero],
        html.hero-pending [data-hero-nav] {
          opacity: 1;
          transform: none;
        }
      }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Inter:wght@300..700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Inter:wght@300..700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta
      property="og:image:alt"
      content="Preview card for Divine Obeten portfolio"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script>
      document.addEventListener("astro:page-load", () => {
        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener("click", (e) => {
            e.preventDefault();
            const href = anchor.getAttribute("href");
            if (!href) return;
            const target = document.querySelector(href);
            target?.scrollIntoView({ behavior: "smooth" });
          });
        });
      });
    </script>
    <script>
      import Lenis from "lenis";

      const lenis = new Lenis();
      if (document.documentElement.classList.contains("is-loading")) {
        lenis.stop();
      }

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      window.addEventListener("preloader:end", () => lenis.start());
    </script>

    <script>
      import type { TransitionBeforeSwapEvent } from "astro:transitions/client";

      document.addEventListener("astro:before-swap", (e) => {
        const { to, newDocument } = e as TransitionBeforeSwapEvent;
        if (to.pathname === "/") {
          newDocument.documentElement.classList.add("hero-pending");
        }
      });
    </script>

    <ClientRouter />
  </head>
  <body class="min-h-screen font-sans bg-bg antialiased">
    <Navbar />
    <Preloader />
    <main transition:animate="slide" class="min-h-screen">
      <slot />
    </main>
    <Footer />
  </body>
</html>
