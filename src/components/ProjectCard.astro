---
interface Props {
  title: string;
  category: string;
  year: string;
  problem: string;
  role: string;
  outcome: string;
  tags: string[];
  image: string;
  slug: string;
  live?: string;
  caseStudy: boolean;
  order?: number;
}

const {
  title,
  category,
  year,
  problem,
  role,
  outcome,
  tags,
  image,
  slug,
  live,
  caseStudy,
  order,
} = Astro.props;
---

<article class="group cursor-pointer flex flex-col gap-4 w-full">
  <!-- Image -->
  <!-- <a href={`/projects/${slug}`} class="block overflow-hidden"> -->
  <div class="relative w-full aspect-4/3 bg-neutral-100 overflow-hidden">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    />
  </div>
  <!-- </a> -->

  <!-- Meta row -->
  <div class="flex items-center justify-between">
    <p class="font-display text-xs uppercase tracking-[0.2em] text-muted">
      {category}
    </p>
    {
      order && (
        <p class="font-display text-xs text-muted">
          {String(order).padStart(2, "0")}
        </p>
      )
    }
  </div>

  <!-- Title + year -->
  <div class="flex items-start justify-between gap-4">
    <a
      href={`/projects/${slug}`}
      class="text-xl font-normal hover:underline underline-offset-4 transition-all duration-200"
    >
      {title}
    </a>
    <span class="shrink-0 font-display text-xs text-muted mt-1">{year}</span>
  </div>

  <!-- Description: problem → role → outcome -->
  <div class="flex flex-col gap-1 text-sm text-muted leading-relaxed max-w-md">
    <p><span class="text-black font-medium">Problem —</span> {problem}</p>
    <p><span class="text-black font-medium">Role —</span> {role}</p>
    <p><span class="text-black font-medium">Outcome —</span> {outcome}</p>
  </div>

  <!-- Tags -->
  <div class="flex flex-wrap gap-2">
    {
      tags.map((tag) => (
        <span class="font-display text-xs px-3 py-1 border border-neutral-200 text-muted">
          {tag}
        </span>
      ))
    }
  </div>

  <!-- Links -->
  <div class="flex items-center gap-4 mt-1">
    {
      caseStudy && (
        <a
          href={`/projects/${slug}`}
          class="font-display text-xs uppercase tracking-[0.2em] text-black hover:underline underline-offset-4 transition-all duration-200"
        >
          Case Study →
        </a>
      )
    }
    {
      live && (
        <a
          href={live}
          target="_blank"
          rel="noopener noreferrer"
          class="font-display text-xs uppercase tracking-[0.2em] text-muted hover:text-black transition-colors duration-200"
        >
          Live ↗
        </a>
      )
    }
  </div>
</article>
