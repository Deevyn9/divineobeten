---
const links = [
  { href: "/", label: "01 Home" },
  { href: "/about", label: "02 About" },
  { href: "/projects", label: "03 Projects" },
  { href: "/contact", label: "04 Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 z-50 w-full bg-white">
  <div class="relative">
    <nav
      class="relative z-30 bg-white mx-auto flex w-full lg:4xl xl:w-6xl items-center justify-between px-5 xl:px-0 py-4"
    >
      <a
        class="text-xl outline-none md:text-2xl font-display font-black tracking-wide text-black capitalize"
        href="/"
      >
        obeten
      </a>

      <div class="hidden items-center gap-5 md:flex font-display text-sm">
        {
          links.map((link) => {
            const isActive = currentPath === link.href;
            return (
              <a
                class={`hover:scale-110 outline-none transition-transform duration-200 ${isActive ? "font-bold text-black" : "font-light text-gray-500"}`}
                href={link.href}
              >
                {link.label}
              </a>
            );
          })
        }
      </div>

      <button
        id="menu-btn"
        class="md:hidden grid grid-cols-3 gap-0.5 p-1"
        aria-label="Toggle menu"
      >
        {
          Array.from({ length: 9 }).map((_, i) => (
            <span
              data-dot={i}
              class="block w-1 h-1 rounded-full bg-black transition-colors duration-200"
            />
          ))
        }
      </button>
    </nav>

    <div
      id="mobile-menu"
      class="md:hidden z-20 flex flex-col px-5 pb-6 gap-5 font-display text-sm bg-white absolute w-full transition-transform duration-300 ease-in-out"
      style="transform: translateY(-150%)"
    >
      {
        links.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              class={`${isActive ? "font-bold text-black" : "font-light text-gray-500"}`}
              href={link.href}
            >
              {link.label}
            </a>
          );
        })
      }
    </div>
  </div>
</header>

<div
  id="menu-backdrop"
  class="fixed inset-0 z-40 backdrop-blur-[7px] bg-black/10 opacity-0 pointer-events-none transition-opacity duration-300"
>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    const backdrop = document.getElementById("menu-backdrop");
    const dots = btn?.querySelectorAll("[data-dot]");

    const greyDots = new Set([1, 3, 5, 7]);
    let isOpen = false;

    const openMenu = () => {
      isOpen = true;
      if (menu) menu.style.transform = "translateY(0)";
      if (backdrop) {
        backdrop.style.opacity = "1";
        backdrop.style.pointerEvents = "auto";
      }
      document.body.style.overflow = "hidden";
      dots?.forEach((dot, i) => {
        (dot as HTMLElement).style.backgroundColor = greyDots.has(i)
          ? "#9ca3af"
          : "#000000";
      });
    };

    const closeMenu = () => {
      isOpen = false;
      if (menu) menu.style.transform = "translateY(-150%)";
      if (backdrop) {
        backdrop.style.opacity = "0";
        backdrop.style.pointerEvents = "none";
      }
      document.body.style.overflow = "";
      dots?.forEach((dot) => {
        (dot as HTMLElement).style.backgroundColor = "#000000";
      });
    };

    btn?.addEventListener("click", () => (isOpen ? closeMenu() : openMenu()));
    backdrop?.addEventListener("click", closeMenu);
  });
</script>
