---
const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Works" },
  { href: "/#about", label: "Him" },
  { href: "/explorations", label: "Explorations" },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 z-50 w-full bg-bg transition-transform duration-300 ease-in-out"
>
  <div class="relative">
    <nav
      data-hero-nav
      class="relative z-30 bg-bg mx-auto flex w-full xl:w-6xl items-center justify-between px-5 xl:px-0 py-4"
    >
      <a
        class="text-lg outline-none md:text-2xl font-display font-semibold tracking-normal text-fg capitalize"
        href="/"
      >
        o<span class="italic -ml-0.75 mr-px">b</span>eten.
      </a>

      <div class="hidden items-center gap-5 md:flex font-display text-sm">
        {
          links.map((link) => {
            const isActive = currentPath === link.href;
            return (
              <a
                class={`nav-link relative flex items-center gap-1 outline-none transition-all duration-200 ${isActive ? "font-bold text-fg" : "font-light text-muted"}`}
                href={link.href}
              >
                <span class="nav-arrow inline-block translate-x-0 opacity-0 transition-all duration-200 ease-out">
                  ↗
                </span>
                {link.label}
              </a>
            );
          })
        }

        <button
          type="button"
          aria-label="Toggle theme"
          class="theme-toggle cursor-pointer text-muted hover:text-fg transition-colors"
        >
          <svg
            class="size-4 dark:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
          <svg
            class="hidden size-4 dark:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
        </button>
      </div>

      <button
        id="menu-btn"
        class="md:hidden grid grid-cols-3 gap-0.5 p-1"
        aria-label="Toggle menu"
      >
        {
          Array.from({ length: 9 }).map((_, i) => (
            <span
              data-dot={i}
              class="block w-1 h-1 rounded-full bg-fg transition-colors duration-200"
            />
          ))
        }
      </button>
    </nav>

    <div
      id="mobile-menu"
      class="md:hidden z-20 flex flex-col px-5 pb-6 gap-5 font-display text-sm bg-bg absolute w-full transition-transform duration-300 ease-in-out"
      style="transform: translateY(-150%)"
    >
      {
        links.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              class={`${isActive ? "font-bold text-fg" : "font-light text-muted"}`}
              href={link.href}
            >
              {link.label}
            </a>
          );
        })
      }

      <button
        type="button"
        aria-label="Toggle theme"
        class="theme-toggle flex items-center gap-2 text-left font-light text-muted hover:text-fg transition-colors"
      >
        <span class="dark:hidden">Dark mode</span>
        <span class="hidden dark:inline">Light mode</span>
      </button>
    </div>
  </div>
</header>

<div
  id="menu-backdrop"
  class="fixed inset-0 z-40 backdrop-blur-[7px] bg-black/10 dark:bg-black/40 opacity-0 pointer-events-none transition-opacity duration-300"
>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    // --- scroll hide/show ---
    const header = document.getElementById("site-header");
    let lastScrollY = window.scrollY;
    let ticking = false;
    let isOpen = false;

    window.addEventListener("scroll", () => {
      if (ticking || isOpen) return;
      window.requestAnimationFrame(() => {
        const currentScrollY = window.scrollY;

        if (currentScrollY <= 0) {
          // at the very top, always show
          header?.style.setProperty("transform", "translateY(0)");
        } else if (currentScrollY > lastScrollY) {
          // scrolling down — hide
          header?.style.setProperty("transform", "translateY(-100%)");
        } else {
          // scrolling up — show
          header?.style.setProperty("transform", "translateY(0)");
        }

        lastScrollY = currentScrollY;
        ticking = false;
      });

      ticking = true;
    });

    // --- arrow hover effect ---
    const navLinks = document.querySelectorAll(".nav-link");

    navLinks.forEach((link) => {
      const arrow = link.querySelector(".nav-arrow") as HTMLElement;

      link.addEventListener("mouseenter", () => {
        if (!arrow) return;
        arrow.style.opacity = "1";
        arrow.style.transform = "translateX(0px)";
      });

      link.addEventListener("mouseleave", () => {
        if (!arrow) return;
        arrow.style.opacity = "0";
        arrow.style.transform = "translateX(-6px)";
      });
    });

    // --- theme toggle ---
    document.querySelectorAll(".theme-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = !document.documentElement.classList.contains("dark");
        document.documentElement.classList.toggle("dark", next);
        try {
          localStorage.setItem("theme", next ? "dark" : "light");
        } catch {}
      });
    });

    // --- mobile menu ---
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    const backdrop = document.getElementById("menu-backdrop");
    const dots = btn?.querySelectorAll("[data-dot]");

    const greyDots = new Set([1, 3, 5, 7]);

    let savedScrollY = 0;

    const openMenu = () => {
      isOpen = true;
      savedScrollY = window.scrollY;
      header?.style.setProperty("transform", "translateY(0)");
      if (menu) menu.style.transform = "translateY(0)";
      if (backdrop) {
        backdrop.style.opacity = "1";
        backdrop.style.pointerEvents = "auto";
      }
      document.body.style.position = "fixed";
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.width = "100%";
      dots?.forEach((dot, i) => {
        (dot as HTMLElement).style.backgroundColor = greyDots.has(i)
          ? "var(--muted)"
          : "var(--fg)";
      });
    };

    const closeMenu = () => {
      isOpen = false;
      if (menu) menu.style.transform = "translateY(-150%)";
      if (backdrop) {
        backdrop.style.opacity = "0";
        backdrop.style.pointerEvents = "none";
      }
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.width = "";
      window.scrollTo(0, savedScrollY);
      dots?.forEach((dot) => {
        (dot as HTMLElement).style.backgroundColor = "var(--fg)";
      });
    };

    btn?.addEventListener("click", () => (isOpen ? closeMenu() : openMenu()));
    backdrop?.addEventListener("click", closeMenu);
    const mobileLinks = menu?.querySelectorAll("a");
    mobileLinks?.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  });
</script>
