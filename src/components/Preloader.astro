---
import AstroDark from "../assets/icons/Astro_dark.svg";
import Javascript from "../assets/icons/javascript.svg";
import NextJS from "../assets/icons/nextjs_icon_dark.svg";
import NodeJS from "../assets/icons/nodejs.svg";
import ReactDark from "../assets/icons/React_dark.svg";
import Redux from "../assets/icons/redux.svg";
import TailwindCSS from "../assets/icons/tailwindcss.svg";
import Typescript from "../assets/icons/typescript.svg";
import Vue from "../assets/icons/vue.svg";

const icons = [
  AstroDark,
  Javascript,
  NextJS,
  NodeJS,
  ReactDark,
  Redux,
  TailwindCSS,
  Typescript,
  Vue,
];
---

<div
  class="preloader fixed top-0 bg-bg inset-0 z-9999 place-items-center"
  aria-hidden="true"
>
  <div
    id="trail-wrapper"
    class="absolute inset-0 overflow-hidden pointer-events-none"
  >
    {
      icons.map((icon) => (
        <img class="flair absolute opacity-0 w-12 h-12" src={icon.src} />
      ))
    }
  </div>

  <div
    class="flex flex-col items-center text-2xl uppercase text-gray-900 font-semibold leading-6"
  >
    <span>Divine Obeten</span>
    <span class="text-xs">(wiggle your mouse around.)</span>
  </div>
  <div
    class="absolute flex gap-1 items-center capitalize italic text-gray-900 right-5 bottom-5 font-semibold"
  >
    <div class="absolute right-5 bottom-5 font-semibold text-gray-900">
      <span id="preloader-count" class="text-sm tabular-nums">0%</span>
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  gsap.defaults({ duration: 1 });

  // clear flag on actual page reload/close, not on client-side nav
  window.addEventListener("beforeunload", () => {
    sessionStorage.removeItem("preloaderDone");
  });

  const initPreloader = () => {
    if (sessionStorage.getItem("preloaderDone")) return; // ← just return, no hiding needed

    const preloader = document.querySelector(
      ".preloader",
    ) as HTMLElement | null;
    const countEl = document.getElementById("preloader-count");

    if (!preloader || !countEl) return;

    preloader.classList.add("is-active"); // ← add this line here

    sessionStorage.setItem("preloaderDone", "true");

    const flair = gsap.utils.toArray<HTMLImageElement>(".flair");
    const wrapper = gsap.utils.wrap(0, flair.length);
    let index = 0;
    const gap = 90;
    let mousePos = { x: 0, y: 0 };
    let lastMousePos = { x: 0, y: 0 };
    let cachedMousePos = { x: 0, y: 0 };

    function playAnimation(shape: HTMLImageElement) {
      const tl = gsap.timeline();
      tl.from(shape, { opacity: 0, scale: 0, ease: "elastic.out(1,0.3)" })
        .to(shape, { rotation: "random([-360, 360])" }, "<")
        .to(shape, { y: "120vh", ease: "back.in(.4)", duration: 1 }, 0);
    }

    function animateImage() {
      const wrappedIndex = wrapper(index);
      const img = flair[wrappedIndex];
      gsap.killTweensOf(img);
      gsap.set(img, { clearProps: "all" });
      gsap.set(img, {
        opacity: 1,
        left: mousePos.x,
        top: mousePos.y,
        xPercent: -50,
        yPercent: -50,
      });
      playAnimation(img);
      index++;
    }

    function ImageTrail() {
      const travelDistance = Math.hypot(
        lastMousePos.x - mousePos.x,
        lastMousePos.y - mousePos.y,
      );
      cachedMousePos.x = gsap.utils.interpolate(
        cachedMousePos.x || mousePos.x,
        mousePos.x,
        0.1,
      );
      cachedMousePos.y = gsap.utils.interpolate(
        cachedMousePos.y || mousePos.y,
        mousePos.y,
        0.1,
      );
      if (travelDistance > gap) {
        animateImage();
        lastMousePos = { ...mousePos };
      }
    }

    window.addEventListener("mousemove", (e) => {
      mousePos = { x: e.clientX, y: e.clientY };
    });

    gsap.ticker.add(ImageTrail);

    window.dispatchEvent(new Event("preloader:start"));

    const isMobile = window.matchMedia("(pointer: coarse)").matches;

    const unlockScroll = () => {
      document.body.style.overflow = "";
      document.documentElement.style.overflow = "";
      window.dispatchEvent(new Event("preloader:end"));
      gsap.ticker.remove(ImageTrail);
    };

    const exitPreloader = () => {
      gsap.to(preloader, {
        yPercent: -100,
        duration: 0.9,
        ease: "power3.out",
        onComplete: unlockScroll,
      });
    };

    const counter = { val: 0 };
    gsap.to(counter, {
      val: 100,
      duration: 3.5,
      ease: "power1.inOut",
      onUpdate: () => {
        countEl.textContent = `${Math.round(counter.val)}%`;
      },
      onComplete: () => {
        if (isMobile) {
          countEl.textContent = "tap screen";
          preloader?.addEventListener("click", exitPreloader, { once: true });
        } else {
          gsap.delayedCall(0.4, exitPreloader);
        }
      },
    });
  };

  document.addEventListener("astro:page-load", initPreloader);
  initPreloader();
</script>
