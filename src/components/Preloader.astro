---
import AstroDark from "../assets/icons/Astro_dark.svg";
import Javascript from "../assets/icons/javascript.svg";
import NextJS from "../assets/icons/nextjs_icon_dark.svg";
import NodeJS from "../assets/icons/nodejs.svg";
import ReactDark from "../assets/icons/React_dark.svg";
import Redux from "../assets/icons/redux.svg";
import TailwindCSS from "../assets/icons/tailwindcss.svg";
import Typescript from "../assets/icons/typescript.svg";
import Vue from "../assets/icons/vue.svg";

const icons = [
  AstroDark,
  Javascript,
  NextJS,
  NodeJS,
  ReactDark,
  Redux,
  TailwindCSS,
  Typescript,
  Vue,
];
---

<div
  class="preloader fixed top-0 bg-bg inset-0 z-9999 place-items-center"
  aria-hidden="true"
>
  <div
    id="trail-wrapper"
    class="absolute inset-0 overflow-hidden pointer-events-none"
  >
    {
      icons.map((icon) => (
        <img
          class="flair absolute opacity-0 w-12 h-12"
          src={icon.src}
          alt=""
          decoding="async"
        />
      ))
    }
  </div>

  <div
    class="flex flex-col items-center text-3xl sm:text-4xl uppercase text-gray-900 font-semibold leading-6"
  >
    <span class="font-display">Divine Obeten</span>
    <span class="text-xs" id="preloader-subtitle"
      >(wiggle your mouse around.)</span
    >
  </div>

  <div class="absolute right-5 bottom-5 font-semibold text-gray-900">
    <span id="preloader-count" class="text-sm tabular-nums">0%</span>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  gsap.defaults({ duration: 1 });

  let started = false;

  const initPreloader = () => {
    const root = document.documentElement;
    if (started || !root.classList.contains("is-loading")) return;

    const preloader = document.querySelector(
      ".preloader",
    ) as HTMLElement | null;
    const countEl = document.getElementById("preloader-count");
    if (!preloader || !countEl) return;

    started = true;

    const isMobile = window.matchMedia("(pointer: coarse)").matches;
    const subtitle = document.getElementById("preloader-subtitle");
    if (isMobile && subtitle) {
      subtitle.textContent = "(tap screen for a surprise)";
    }

    // mouse / touch trail
    const flair = gsap.utils.toArray<HTMLImageElement>(".flair");
    const wrapper = gsap.utils.wrap(0, flair.length);
    let index = 0;
    const gap = 90;
    let mousePos = { x: 0, y: 0 };
    let lastMousePos = { x: 0, y: 0 };

    const playAnimation = (shape: HTMLImageElement) => {
      gsap
        .timeline()
        .from(shape, { opacity: 0, scale: 0, ease: "elastic.out(1,0.3)" })
        .to(shape, { rotation: "random([-360, 360])" }, "<")
        .to(shape, { y: "120vh", ease: "back.in(.4)", duration: 1 }, 0);
    };

    const animateImage = () => {
      const img = flair[wrapper(index)];
      gsap.killTweensOf(img);
      gsap.set(img, { clearProps: "all" });
      gsap.set(img, {
        opacity: 1,
        left: mousePos.x,
        top: mousePos.y,
        xPercent: -50,
        yPercent: -50,
      });
      playAnimation(img);
      index++;
    };

    const imageTrail = () => {
      const travel = Math.hypot(
        lastMousePos.x - mousePos.x,
        lastMousePos.y - mousePos.y,
      );
      if (travel > gap) {
        animateImage();
        lastMousePos = { ...mousePos };
      }
    };

    const onMove = (e: MouseEvent) => {
      mousePos = { x: e.clientX, y: e.clientY };
    };
    const onTouch = (e: TouchEvent) => {
      const t = e.touches[0];
      mousePos = { x: t.clientX, y: t.clientY };
    };

    window.addEventListener("mousemove", onMove);
    window.addEventListener("touchstart", onTouch, { passive: true });
    window.addEventListener("touchmove", onTouch, { passive: true });
    gsap.ticker.add(imageTrail);

    const cleanup = () => {
      gsap.ticker.remove(imageTrail);
      window.removeEventListener("mousemove", onMove);
      window.removeEventListener("touchstart", onTouch);
      window.removeEventListener("touchmove", onTouch);
      root.classList.remove("is-loading");
      window.dispatchEvent(new Event("preloader:end"));
    };

    const exitPreloader = () => {
      window.dispatchEvent(new Event("preloader:exit"));
      gsap.to(preloader, {
        yPercent: -100,
        duration: 0.9,
        ease: "power3.out",
        onComplete: cleanup,
      });
    };

    const counter = { val: 0 };
    gsap.to(counter, {
      val: 100,
      duration: 3.5,
      ease: "power1.inOut",
      onUpdate: () => {
        countEl.textContent = `${Math.round(counter.val)}%`;
      },
      onComplete: () => gsap.delayedCall(0.4, exitPreloader),
    });
  };

  document.addEventListener("astro:page-load", initPreloader);
  initPreloader();
</script>
