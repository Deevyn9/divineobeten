---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact | Divine Obeten"
  description="Get in touch with Divine Obeten for opportunities, collaborations, or freelance work."
  image="/og-image.svg"
>
  <section class="px-6 py-24 sm:px-10 lg:px-16">
    <div class="mx-auto max-w-4xl space-y-6">
      <p class="eyebrow">Contact</p>
      <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">
        Make it easy for the right people to reach you.
      </h1>
      <div class="panel space-y-4">
        <p class="text-base leading-8 text-neutral-300">
          Update this page with your email, social links, or a contact form once you&apos;re ready.
        </p>
        <a class="button-primary" href="mailto:hello@divineobeten.com">Send an email</a>
      </div>
    </div>
  </section>
</Layout>
