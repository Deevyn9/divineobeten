---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project: CollectionEntry<"projects">) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await project.render();
const {
  title,
  category,
  year,
  description,
  tags,
  image,
  images,
  live,
  caseStudy,
} = project.data;
---

<Layout title={`Dive deeper in my work on ${title}`}>
  <main class="mx-auto text-muted w-full xl:w-6xl px-5 xl:px-0 pt-24 pb-20">
    <!-- Back link -->
    <a
      href="/projects"
      class="inline-flex items-center gap-1 font-display text-xs
    uppercase tracking-[0.2em] text-muted hover:text-black transition-colors
    duration-200 mb-12"
    >
      ← All Projects
    </a>

    <!-- Header -->
    <div class="mb-8">
      <p
        class="font-display text-xs uppercase tracking-[0.2em] text-muted mb-3"
      >
        {category} — {year}
      </p>
      <h1 class="text-3xl md:text-5xl text-black font-normal mb-4 max-w-3xl">
        {title}
      </h1>
      <p class="text-sm text-muted leading-relaxed max-w-2xl">{description}</p>
    </div>

    <!-- Tags + links -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-12">
      <div class="flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <span class="font-display text-xs px-3 py-1 border border-neutral-200 text-muted">
              {tag}
            </span>
          ))
        }
      </div>
      <div class="flex items-center gap-4">
        {
          live && (
            <a
              href={live}
              target="_blank"
              rel="noopener noreferrer"
              class="font-display text-xs uppercase tracking-[0.2em] text-black hover:underline underline-offset-4"
            >
              Live ↗
            </a>
          )
        }
      </div>
    </div>

    <!-- Hero image -->
    <div class="w-full aspect-video bg-neutral-100 overflow-hidden mb-16">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Case study content -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-16 mb-8">
      <!-- Main content -->
      <div class="prose prose-neutral max-w-none">
        <Content />
      </div>

      <!-- Sidebar -->
      <aside class="flex flex-col gap-8 lg:pt-1">
        <div>
          <p
            class="font-display font-medium text-xs uppercase tracking-[0.2em] text-black mb-3"
          >
            Category
          </p>
          <p class="text-sm">{category}</p>
        </div>
        <div>
          <p
            class="font-display font-medium text-xs uppercase tracking-[0.2em] text-black mb-3"
          >
            Year
          </p>
          <p class="text-sm">{year}</p>
        </div>
        <div>
          <p
            class="font-display font-medium text-xs uppercase tracking-[0.2em] text-black mb-3"
          >
            Stack
          </p>
          <div class="flex flex-col gap-1">
            {tags.map((tag) => <p class="text-sm">{tag}</p>)}
          </div>
        </div>
        {
          live && (
            <div>
              <p class="font-display text-xs uppercase tracking-[0.2em] text-muted mb-3">
                Live
              </p>
              <a
                href={live}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm hover:underline underline-offset-4"
              >
                View site ↗
              </a>
            </div>
          )
        }
      </aside>
    </div>

    <!-- Extra images grid -->
    <p class="font-display text-sm text-muted mb-2 mt-5 italic">
      Selected Screens
    </p>
    {
      images && images.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
          {images.map((img, i) => (
            <div class="w-full bg-neutral-100/50 p-5 overflow-hidden">
              <img
                src={img}
                alt={`${title} screenshot ${i + 1}`}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      )
    }

    <!-- Back Home -->
    <div class="border-t border-neutral-200 pt-12">
      <a
        href="/"
        class="group inline-flex items-center gap-2 font-display text-xs uppercase tracking-[0.2em] text-muted hover:text-black transition-colors duration-200"
      >
        <span
          class="group-hover:-translate-x-0.5 transition-transform duration-200"
          >←</span
        >
        Back Home
      </a>
    </div>
  </main>
</Layout>
