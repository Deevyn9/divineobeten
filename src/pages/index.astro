---
import FeaturedExplorations from "../components/FeaturedExplorations.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Divine Obeten | Frontend Engineer"
  description="Frontend Engineer"
  image="/images/linkimg.webp"
>
  <main
    class="min-h-screen text-black bg-[radial-gradient(circle,#ebebeb_1px,transparent_1px)] bg-size-[28px_28px]"
  >
    <div class="mx-auto w-full xl:w-6xl px-5 xl:px-0">
      <!-- hero section -->
      <section
        class="relative overflow-hidden lg:pb-10 pt-24 md:pt-20 lg:pt-32 flex flex-col"
      >
        <p data-hero class="text-xs text-muted font-display mb-2 sm:mb-0">
          Enugu, Nigeria — <span
            id="local-time"
            class="text-black font-semibold text-base"></span>
        </p>
        <h3
          data-hero
          class="text-xl md:text-3xl max-w-[90%] sm:max-w-175 font-normal"
        >
          Frontend Engineer. I've built across fintech, edtech, ecommerce, and
          web3 — and somewhere along the way I became obsessed with how things
          feel, not just what they do.
        </h3>
        <div data-hero class="mt-3 lg:mt-5 flex items-center gap-1">
          <div class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></div>
          <p class="font-display text-xs uppercase leading-none">
            available for global opportunities
          </p>
        </div>
        <div
          data-hero
          class="mt-10 lg:mt-7 md:mt-auto flex flex-col gap-y-8 md:flex-row md:items-end md:justify-between"
        >
          <p class="max-w-lg text-sm text-muted">
            Motion systems, creative tooling, typography, and expressive
            frontend experiences.
          </p>

          <div class="text-black text-left md:text-right">
            <p class="mb-2 font-medium text-sm uppercase font-display">
              Currently Exploring
            </p>

            <div class="space-y-1 tracking-[0.02em] font-normal text-xs">
              <p>Creative Development</p>
              <p>Interaction Systems</p>
              <p>Motion Design</p>
              <p>Frontend Architecture</p>
              <p>Design Engineering</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Works section -->
      <div data-hero>
        <FeaturedProjects />
      </div>

      <!-- About section -->
      <section class="pt-20 w-full" id="about">
        <div class="mb-7">
          <p
            class="font-display text-xs uppercase tracking-[0.2em] text-muted mb-1"
          >
            Who is he?
          </p>
          <h2 class="text-2xl md:text-3xl tracking-normal font-medium">
            A<span class="italic">b</span>out
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
          <div class="flex flex-col gap-4 text-sm text-muted leading-relaxed">
            <p>
              Hi, I'm Divine Obeten, a Frontend Engineer with 3+ years of
              experience building products across fintech, edtech, ecommerce,
              and web3.
            </p>
            <p>
              Outside work, you'll usually find me playing football, gaming,
              reading, in the gym, or trying (very slowly) to get better at
              drawing.
            </p>
            <p>
              I enjoy building interfaces that feel fast, polished, and
              intuitive. Over the years, I've realised I care just as much about
              how a product feels as how it functions. The details matter — the
              animation that guides attention, the feedback that reassures a
              user, the little moments that make an experience feel intentional.
            </p>
            <p>
              Most of my work has been on products used by real customers, where
              reliability matters as much as design. I like working at the point
              where engineering and user experience meet: turning complex
              requirements into interfaces that feel simple.
            </p>
          </div>

          <!-- Right: experience -->
          <div class="flex flex-col">
            <p
              class="font-display text-xs uppercase tracking-[0.2em] text-muted mb-4"
            >
              Experience
            </p>
            {
              [
                {
                  company: "SeguraPay",
                  role: "Software Engineer - Frontend",
                  period: "2024 — Present",
                  industry: "Fintech / Banking-as-a-Service",
                },
                {
                  company: "Illusion Services",
                  role: "Frontend Developer",
                  period: "2024 — 2025",
                  industry: "Agency",
                },
                {
                  company: "Medorii Innovations",
                  role: "Frontend Developer",
                  period: "2023",
                  industry: "Web3",
                },
                {
                  company: "Stunhaul",
                  role: "Frontend Developer",
                  period: "2022",
                  industry: "Logistics / Ecommerce",
                },
                {
                  company: "Freelance",
                  role: "Frontend Developer",
                  period: "2022 — 2023",
                  industry: "",
                },
              ].map((exp) => (
                <div class="flex flex-col gap-1 py-4 border-b border-neutral-200 last:border-none">
                  <div class="flex flex-col sm:flex-row items-start justify-between gap-y-2 sm:gap-4">
                    <div>
                      <p class="text-sm font-medium text-black">
                        {exp.company}
                      </p>
                      <p class="font-display text-xs text-muted mt-0.5">
                        {exp.role}
                      </p>
                    </div>
                    <div class="text-left sm:text-right flex-col-reverse flex sm:flex-col">
                      <span class="font-display text-xs text-muted shrink-0">
                        {exp.period}
                      </span>
                      {exp.industry && (
                        <p class="text-sm text-muted mt-0.5 md:mt-2">
                          {exp.industry}
                        </p>
                      )}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Skills: full width below grid -->
        <div class="mt-16 flex flex-col gap-6">
          <p class="font-display text-xs uppercase tracking-[0.2em] text-muted">
            Skills & Tools
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
              <p
                class="font-display text-xs uppercase tracking-[0.2em] text-muted mb-3"
              >
                Core
              </p>
              <div class="flex flex-wrap gap-2">
                {
                  [
                    "React",
                    "Next.js",
                    "TypeScript",
                    "JavaScript",
                    "Astro",
                    "Tailwind CSS",
                    "HTML/CSS",
                    "NodeJS",
                    "Redux",
                    "Vue",
                  ].map((s) => (
                    <span class="font-display text-xs px-3 py-1 border border-neutral-200 text-black">
                      {s}
                    </span>
                  ))
                }
              </div>
            </div>
            <div>
              <p
                class="font-display text-xs uppercase tracking-[0.2em] text-muted mb-3"
              >
                Motion & Design
              </p>
              <div class="flex flex-wrap gap-2">
                {
                  [
                    "GSAP",
                    "Framer Motion",
                    "Interaction Design",
                    "Figma",
                    "Design Systems",
                    "UI Animation",
                  ].map((s) => (
                    <span class="font-display text-xs px-3 py-1 border border-neutral-200 text-black">
                      {s}
                    </span>
                  ))
                }
              </div>
            </div>
            <div>
              <p
                class="font-display text-xs uppercase tracking-[0.2em] text-muted mb-3"
              >
                Engineering
              </p>
              <div class="flex flex-wrap gap-2">
                {
                  [
                    "Creative Development",
                    "Frontend Architecture",
                    "REST APIs",
                    "Git/GitHub",
                    "Responsive Design",
                    "Web3",
                  ].map((s) => (
                    <span class="font-display text-xs px-3 py-1 border border-neutral-200 text-black">
                      {s}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <FeaturedExplorations />
    </div>

    <script>
      function updateTime() {
        const el = document.getElementById("local-time");
        if (!el) return;

        const now = new Date();
        const time = now.toLocaleTimeString("en-US", {
          timeZone: "Africa/Lagos",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hour12: true,
        });

        el.textContent = `${time} WAT`;
      }

      updateTime();
      setInterval(updateTime, 1000);
    </script>

    <script>
      import { gsap } from "gsap";

      const revealHero = () => {
        const root = document.documentElement;
        const items = gsap.utils.toArray<HTMLElement>("[data-hero]");

        if (
          !items.length ||
          window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          root.classList.remove("hero-pending");
          return;
        }

        gsap.fromTo(
          items,
          { y: 32, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.7,
            ease: "power3.out",
            stagger: 0.08,
            onComplete: () => gsap.set(items, { clearProps: "all" }),
          },
        );
        // GSAP has already written inline styles, so dropping the class can't flash
        root.classList.remove("hero-pending");
      };

      const initHero = () => {
        if (!document.documentElement.classList.contains("hero-pending"))
          return;

        // first load: wait for the preloader to exit. navigation: play immediately
        if (document.documentElement.classList.contains("is-loading")) {
          window.addEventListener("preloader:end", revealHero, { once: true });
        } else {
          revealHero();
        }
      };

      document.addEventListener("astro:page-load", initHero);
    </script>
  </main></Layout
>
