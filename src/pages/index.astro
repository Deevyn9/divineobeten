---
import FeaturedProjects from "../components/FeaturedProjects.astro";
import Layout from "../layouts/Layout.astro";

const skills = [
  "Frontend Engineering",
  "Responsive UI Systems",
  "Motion Design",
  "Design-to-Code",
  "JavaScript / TypeScript",
  "Performance-minded Builds",
];

const sections = [
  {
    eyebrow: "About",
    title: "A sharp personal introduction goes here.",
    copy: "Use this section to explain who you are, what you care about, and the kind of work you want to be known for.",
  },
  {
    eyebrow: "Projects",
    title: "Showcase work with context, not just screenshots.",
    copy: "We can turn each project into a case study with the challenge, your thinking, the stack, and the outcome.",
  },
  {
    eyebrow: "Experience",
    title: "Tell the story behind your growth.",
    copy: "List roles, freelance work, leadership, internships, or meaningful contributions that build trust fast.",
  },
  {
    eyebrow: "Contact",
    title: "Make it easy to reach you.",
    copy: "Add email, socials, and a call to action for recruiters, founders, or clients who land here.",
  },
];
---

<Layout
  title="Divine Obeten | Portfolio"
  description="Frontend Engineer"
  image="/og-image.svg"
>
  <main
    class="min-h-screen text-black bg-[radial-gradient(circle,#ebebeb_1px,transparent_1px)] bg-size-[28px_28px]"
  >
    <div class="mx-auto w-full xl:w-6xl px-5 xl:px-0">
      <!-- hero section -->
      <section
        class="relative overflow-hidden pb-10 pt-20 lg:pt-32 min-h-[70vh] flex flex-col"
      >
        <p class="text-xs text-muted font-display mb-2 sm:mb-0">
          Enugu, Nigeria — <span
            id="local-time"
            class="text-black font-semibold text-base"></span>
        </p>
        <h3 class="text-xl md:text-3xl max-w-175 font-normal">
          Frontend Engineer. I've built across fintech, edtech, ecommerce, and
          web3 — and somewhere along the way I became obsessed with how things
          feel, not just what they do.
        </h3>
        <div class="mt-3 lg:mt-5 flex items-center gap-1">
          <div class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></div>
          <p class="font-display text-xs uppercase leading-none">
            available for global opportunities
          </p>
        </div>
        <div
          class="mt-7 md:mt-auto flex flex-col gap-y-5 md:flex-row md:items-end md:justify-between"
        >
          <div class="max-w-lg text-sm">
            Interested in motion systems, creative tooling, typography, and
            expressive frontend experiences.
          </div>

          <div class="text-xs tracking-[0.2em] text-black text-right">
            <p class="mb-3 uppercase font-display">Currently Exploring</p>

            <div class="space-y-1 font-light">
              <p>Creative Development</p>
              <p>Interaction Systems</p>
              <p>Motion Design</p>
              <p>Frontend Architecture</p>
              <p>Design Engineering</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Works section -->
      <FeaturedProjects />

      <!-- About section -->
      <section class="py-20 w-full" id="about">
        <!-- Section heading -->
        <div class="mb-16">
          <p
            class="font-display text-xs uppercase tracking-[0.2em] text-muted mb-2"
          >
            About
          </p>
          <h2 class="text-2xl md:text-3xl font-normal">Who I Am</h2>
        </div>

        <!-- Main grid: left (bio + skills) / right (experience) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
          <!-- Left: bio + skills -->
          <div class="flex flex-col gap-10">
            <!-- Bio -->
            <div class="flex flex-col gap-4 text-sm text-muted leading-relaxed">
              <p>
                I'm Divine Obeten, a Frontend Engineer based in Enugu, Nigeria.
                I build websites and web apps across fintech, edtech, ecommerce,
                and web3 — and somewhere along the way I became obsessed with
                how things feel, not just what they do.
              </p>
              <p>
                I care deeply about the layer beyond functionality — the
                transitions, the microinteractions, the details that nobody
                explicitly asks for but everybody feels. That's where I operate.
              </p>
              <p>
                Currently working as a founding frontend engineer at SeguraPay,
                building production-grade fintech infrastructure, while actively
                seeking remote opportunities at funded startups and SaaS
                companies that care about craft.
              </p>
            </div>

            <!-- Skills -->
            <div>
              <p
                class="font-display text-xs uppercase tracking-[0.2em] text-muted mb-4"
              >
                Skills & Tools
              </p>
              <div class="flex flex-wrap gap-2">
                {
                  [
                    "React",
                    "Next.js",
                    "TypeScript",
                    "Tailwind CSS",
                    "GSAP",
                    "Framer Motion",
                    "Astro",
                    "REST APIs",
                    "Figma",
                    "Git",
                    "Motion Design",
                    "Design Systems",
                    "Responsive UI",
                    "Web3 / Solidity",
                  ].map((skill) => (
                    <span class="font-display text-xs px-3 py-1 border border-neutral-200 text-muted">
                      {skill}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Right: experience -->
          <div class="flex flex-col gap-6">
            <p
              class="font-display text-xs uppercase tracking-[0.2em] text-muted mb-2"
            >
              Experience
            </p>

            {
              [
                {
                  company: "SeguraPay",
                  role: "Founding Frontend Engineer",
                  period: "2023 — Present",
                  description:
                    "Building the entire frontend of a B2B payment gateway and Banking-as-a-Service platform. Owned the architecture, dashboards, RBAC system, and all user-facing features across three user roles.",
                },
                {
                  company: "Illusion Services",
                  role: "Frontend Developer",
                  period: "2024 — Present",
                  description:
                    "Built across multiple products including a Web3 freelance platform and logistics SaaS. Rebuilt full frontends, integrated APIs, and delivered production-ready interfaces from Figma designs.",
                },
                {
                  company: "Freelance",
                  role: "Frontend Developer",
                  period: "2022 — 2023",
                  description:
                    "Delivered websites and web apps for clients across ecommerce and edtech — including landing pages, multi-page sites, and interactive UIs.",
                },
              ].map((exp) => (
                <div class="flex flex-col gap-1 pb-6 border-b border-neutral-100 last:border-none">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <p class="text-sm font-medium text-black">
                        {exp.company}
                      </p>
                      <p class="font-display text-xs text-muted mt-0.5">
                        {exp.role}
                      </p>
                    </div>
                    <span class="font-display text-xs text-muted shrink-0 mt-0.5">
                      {exp.period}
                    </span>
                  </div>
                  <p class="text-sm text-muted leading-relaxed mt-2">
                    {exp.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- <section class="px-6 py-10 sm:px-10 lg:px-16">
  </div>
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-wrap gap-3">
          {skills.map((skill) => <span class="chip">{skill}</span>)}
        </div>
      </div>
    </section>

    <section id="about" class="px-6 py-10 sm:px-10 lg:px-16">
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2">
        {
          sections.map((section) => (
            <article class="panel min-h-64 space-y-4">
              <p class="eyebrow">{section.eyebrow}</p>
              <h2 class="text-2xl font-semibold tracking-tight text-white">
                {section.title}
              </h2>
              <p class="max-w-xl text-sm leading-7 text-neutral-300">
                {section.copy}
              </p>
            </article>
          ))
        }
      </div>
    </section> -->
    </div>
  </main>
</Layout>

<script>
  function updateTime() {
    const el = document.getElementById("local-time");
    if (!el) return;

    const now = new Date();
    const time = now.toLocaleTimeString("en-US", {
      timeZone: "Africa/Lagos",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: true,
    });

    el.textContent = `${time} WAT`;
  }

  updateTime();
  setInterval(updateTime, 1000);
</script>
