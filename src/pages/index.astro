---
import FeaturedProjects from "../components/FeaturedProjects.astro";
import Layout from "../layouts/Layout.astro";

const skills = [
  "Frontend Engineering",
  "Responsive UI Systems",
  "Motion Design",
  "Design-to-Code",
  "JavaScript / TypeScript",
  "Performance-minded Builds",
];

const sections = [
  {
    eyebrow: "About",
    title: "A sharp personal introduction goes here.",
    copy: "Use this section to explain who you are, what you care about, and the kind of work you want to be known for.",
  },
  {
    eyebrow: "Projects",
    title: "Showcase work with context, not just screenshots.",
    copy: "We can turn each project into a case study with the challenge, your thinking, the stack, and the outcome.",
  },
  {
    eyebrow: "Experience",
    title: "Tell the story behind your growth.",
    copy: "List roles, freelance work, leadership, internships, or meaningful contributions that build trust fast.",
  },
  {
    eyebrow: "Contact",
    title: "Make it easy to reach you.",
    copy: "Add email, socials, and a call to action for recruiters, founders, or clients who land here.",
  },
];
---

<Layout
  title="Divine Obeten | Portfolio"
  description="Frontend Engineer"
  image="/og-image.svg"
>
  <main
    class="min-h-screen text-black bg-[radial-gradient(circle,#ebebeb_1px,transparent_1px)] bg-size-[28px_28px]"
  >
    <div class="mx-auto w-full xl:w-6xl px-5 xl:px-0">
      <!-- hero section -->
      <section
        class="relative overflow-hidden pb-10 pt-20 lg:pt-32 min-h-[70vh] flex flex-col"
      >
        <p class="text-xs text-muted font-display mb-2 sm:mb-0">
          Enugu, Nigeria — <span
            id="local-time"
            class="text-black font-semibold text-base"></span>
        </p>
        <h3 class="text-xl md:text-3xl max-w-175 font-normal">
          Frontend Engineer. I've built across fintech, edtech, ecommerce, and
          web3 — and somewhere along the way I became obsessed with how things
          feel, not just what they do.
        </h3>
        <div class="mt-3 lg:mt-5 flex items-center gap-1">
          <div class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></div>
          <p class="font-display text-xs uppercase leading-none">
            available for global opportunities
          </p>
        </div>
        <div
          class="mt-7 md:mt-auto flex flex-col gap-y-5 md:flex-row md:items-end md:justify-between"
        >
          <div class="max-w-lg text-sm">
            Interested in motion systems, creative tooling, typography, and
            expressive frontend experiences.
          </div>

          <div class="text-xs tracking-[0.2em] text-black text-right">
            <p class="mb-3 uppercase font-display">Currently Exploring</p>

            <div class="space-y-1 font-light">
              <p>Creative Development</p>
              <p>Interaction Systems</p>
              <p>Motion Design</p>
              <p>Frontend Architecture</p>
              <p>Design Engineering</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Works section -->
      <FeaturedProjects />

      <!-- <section class="px-6 py-10 sm:px-10 lg:px-16">
  </div>
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-wrap gap-3">
          {skills.map((skill) => <span class="chip">{skill}</span>)}
        </div>
      </div>
    </section>

    <section id="about" class="px-6 py-10 sm:px-10 lg:px-16">
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2">
        {
          sections.map((section) => (
            <article class="panel min-h-64 space-y-4">
              <p class="eyebrow">{section.eyebrow}</p>
              <h2 class="text-2xl font-semibold tracking-tight text-white">
                {section.title}
              </h2>
              <p class="max-w-xl text-sm leading-7 text-neutral-300">
                {section.copy}
              </p>
            </article>
          ))
        }
      </div>
    </section> -->
    </div>
  </main>
</Layout>

<script>
  function updateTime() {
    const el = document.getElementById("local-time");
    if (!el) return;

    const now = new Date();
    const time = now.toLocaleTimeString("en-US", {
      timeZone: "Africa/Lagos",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: true,
    });

    el.textContent = `${time} WAT`;
  }

  updateTime();
  setInterval(updateTime, 1000);
</script>
