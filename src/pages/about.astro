---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About | Divine Obeten"
  description="Learn more about Divine Obeten, his approach, and the work he wants to be known for."
  image="/og-image.svg"
>
  <section class="px-6 py-24 sm:px-10 lg:px-16">
    <div class="mx-auto max-w-4xl space-y-6">
      <p class="eyebrow">About</p>
      <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">
        This page is ready for your story.
      </h1>
      <p class="panel max-w-3xl text-base leading-8 text-neutral-300">
        Add your background, your values, the kind of products you like building, and the reason
        your work feels different from everyone else&apos;s.
      </p>
    </div>
  </section>
</Layout>
