---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Projects | Divine Obeten"
  description="Selected projects and case studies from Divine Obeten."
  image="/og-image.svg"
>
  <section class="px-6 py-24 sm:px-10 lg:px-16">
    <div class="mx-auto max-w-5xl space-y-6">
      <p class="eyebrow">Projects</p>
      <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">
        A space for featured work and detailed case studies.
      </h1>
      <div class="grid gap-6 md:grid-cols-2">
        <article class="panel space-y-3">
          <h2 class="text-2xl font-semibold text-white">Project One</h2>
          <p class="text-sm leading-7 text-neutral-300">
            Replace this with the project challenge, your solution, and the impact.
          </p>
        </article>
        <article class="panel space-y-3">
          <h2 class="text-2xl font-semibold text-white">Project Two</h2>
          <p class="text-sm leading-7 text-neutral-300">
            Add another project, or turn these cards into links to full project pages later.
          </p>
        </article>
      </div>
    </div>
  </section>
</Layout>
